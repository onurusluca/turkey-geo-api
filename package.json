{
    "name": "turkey-geo-api",
    "version": "1.3.0",
    "packageManager": "bun@1.3.10",
    "description": "Open source API for Turkey geographic data (provinces, districts, neighborhoods, streets, towns/villages) from JSONL",
    "author": "Onur Usluca",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "turkey",
        "geographic",
        "api",
        "provinces",
        "districts",
        "neighborhoods",
        "adres",
        "türkiye",
        "coğrafi",
        "il",
        "ilçe",
        "mahalle",
        "türkçe adres",
        "türkiye adres",
        "türkiye coğrafi"
    ],
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "bun --watch src/index.ts",
        "dev:node": "tsx watch src/index.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^4.22.1",
        "helmet": "^8.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/node": "^22.19.17",
        "eslint": "^9.39.4",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2"
    }
}